# Claude API key (console.anthropic.com) — used for intent detection and replies (lib/ai.ts, claude-haiku-5-5).
# Without it the bot still runs but answers with placeholder text.
ANTHROPIC_API_KEY=

# Demo without Python embedding service or pgvector sync: set to true (uses JSON catalogue + intent filters).
# SKIP_VECTOR_EMBEDDING=true

# LLM-driven follow-up planner (chooses ask/recommend/capture_lead/show_dealer/none after
# recommendations). Adds one extra LLM call per turn when recommendations are shown.
ENABLE_AI_FOLLOWUP=true

# Installation/troubleshooting support (grounded in scraped FAQ content — see
# handlers/installation.ts) and the architect/designer technical-spec persona (see
# handlers/architect.ts). Off by default for now — product recommendation + dealer
# routing only. Set to true to re-enable; requires the `documents` table to be
# populated first (npm run import:documents) or these will mostly escalate/no-match.
# ENABLE_INSTALLATION_SUPPORT=true
# ENABLE_ARCHITECT_ASSISTANT=true

# Supabase (Auth / client APIs). Use the project URL and anon/publishable key from the dashboard.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Postgres for chat sessions / leads / analytics / vectors (same DB Supabase hosts for you).
# Option A — local Postgres:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/carysil_ai
#
# Option B — Supabase (Project Settings → Database → Connection string → URI).
# Use the direct host (db.<project-ref>.supabase.co:5432) or Session pooler if Transaction pooler errors on prepared statements.
# DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
# (equivalent alias)
# SUPABASE_DB_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
#
# Force SSL on/off (optional; auto-enabled for *.supabase hosts):
# DATABASE_SSL=true

# Password for /dashboard (leads + chat transcripts). REQUIRED in production — without it /dashboard is disabled (503).
# DASHBOARD_PASSWORD=
# DASHBOARD_USER=admin

# Shared secret for /api/cron/decay-leads (Authorization: Bearer <secret>). Without it the endpoint runs only in local dev.
# CRON_SECRET=

# Max Postgres connections per server instance (default 10; 3 on Vercel).
# DATABASE_POOL_MAX=3
