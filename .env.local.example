OPENAI_API_KEY=

# Demo without Python embedding service or pgvector sync: set to true (uses JSON catalogue + intent filters).
# SKIP_VECTOR_EMBEDDING=true

# LLM-driven follow-up planner (chooses ask/recommend/capture_lead/show_dealer/none after
# recommendations). Adds one extra LLM call per turn when recommendations are shown.
ENABLE_AI_FOLLOWUP=true

# Supabase (Auth / client APIs). Use the project URL and anon/publishable key from the dashboard.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Postgres for chat sessions / leads / analytics / vectors (same DB Supabase hosts for you).
# Option A — local Postgres:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/carysil_ai
#
# Option B — Supabase (Project Settings → Database → Connection string → URI).
# Use the direct host (db.<project-ref>.supabase.co:5432) or Session pooler if Transaction pooler errors on prepared statements.
# DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
# (equivalent alias)
# SUPABASE_DB_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
#
# Force SSL on/off (optional; auto-enabled for *.supabase hosts):
# DATABASE_SSL=true
