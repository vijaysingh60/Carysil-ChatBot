{
  "name": "carysil-ai-prototype",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "WATCHPACK_POLLING=true next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "embed:products": "node --import tsx scripts/generateProductEmbeddings.ts",
    "import:catalog": "node --import tsx scripts/importCatalogProducts.ts",
    "import:dealers": "node --import tsx scripts/importDealers.ts",
    "import:documents": "node --import tsx scripts/importDocuments.ts",
    "rag:dataset": "node --import tsx eval/generateDataset.ts",
    "rag:eval:retrieval": "node --import tsx eval/retrievalEval.ts",
    "rag:eval:generation": "node --import tsx eval/generationEval.ts",
    "rag:evaluate": "npm run rag:eval:retrieval && npm run rag:eval:generation"
  },
  "dependencies": {
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.105.4",
    "next": "14.2.18",
    "openai": "^4.73.0",
    "pg": "^8.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.4.20",
    "eslint": "^8",
    "eslint-config-next": "14.2.18",
    "postcss": "^8",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.20.5",
    "typescript": "^5"
  }
}
